# The gateway Worker the dashboard proxies /api, /x and /catalog to.
# For `next dev`. On Cloudflare it comes from the GATEWAY_URL var (or a
# GATEWAY service binding) in wrangler.jsonc, read at runtime.
GATEWAY_URL=http://localhost:8787
# Deployed gateway instead of wrangler dev:
# GATEWAY_URL=https://x402-gateway.tollgate-tokyo.workers.dev

# SIWE message domain override. Leave empty to use the page's host. When
# GATEWAY_URL is a remote gateway that checks the domain against its own host,
# set this to that host (e.g. x402-gateway.tollgate-tokyo.workers.dev).
NEXT_PUBLIC_SIWE_DOMAIN=

# How buyers launch the Tollgate MCP server. Shown on the "Use with Claude"
# page in the `claude mcp add` command and the .mcp.json block.
NEXT_PUBLIC_MCP_COMMAND=
